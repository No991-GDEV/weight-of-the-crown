<section class="twoc-shell">
  {{#*inline "crest"}}{{#if crestImage}}<img class="twoc-crest-image" src="{{crestImage}}" alt="Brasão de {{name}}">{{else}}<i class="fa-solid fa-crown" aria-hidden="true"></i>{{/if}}{{/inline}}
  {{#*inline "actorSlot"}}
  <div class="twoc-actor-slot {{#if actorUuid}}has-actor{{/if}} {{#if actorMissing}}is-missing{{/if}}" data-drop-definition="{{id}}" data-drop-kind="{{kind}}" data-actor-uuid="{{actorUuid}}" role="group" aria-label="{{#if slotLabel}}{{slotLabel}}{{else}}Responsável{{/if}} por {{name}}">
    {{#if actorImg}}{{#if canOpenActor}}<button class="twoc-portrait-button" type="button" data-action="openActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Abrir ficha de {{actorName}}"><img class="twoc-actor-portrait" src="{{actorImg}}" alt=""></button>{{else}}<img class="twoc-actor-portrait" src="{{actorImg}}" alt="">{{/if}}{{else}}<span class="twoc-actor-placeholder" aria-hidden="true"><i class="fa-solid fa-user-plus"></i></span>{{/if}}
    <div class="twoc-actor-info"><span>{{#if slotLabel}}{{slotLabel}}{{else}}Responsável{{/if}}</span>
      {{#if actorUuid}}
        {{#if canOpenActor}}<button class="twoc-actor-name" type="button" data-action="openActor" data-id="{{id}}" data-kind="{{kind}}" data-actor-uuid="{{actorUuid}}">{{actorName}}</button>{{else}}<strong>{{actorName}}</strong>{{/if}}
        {{#if actorMissing}}<small>Vínculo indisponível</small>{{/if}}
      {{else}}
        {{#if editable}}<button class="twoc-actor-name" type="button" data-action="chooseActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Escolher {{#if slotLabel}}{{slotLabel}}{{else}}responsável{{/if}} para {{name}}">{{#if emptySlotLabel}}{{emptySlotLabel}}{{else}}Arraste um personagem{{/if}}</button>{{else}}<strong>{{#if emptySlotLabel}}Sem capitão{{else}}Sem responsável{{/if}}</strong>{{/if}}
      {{/if}}
    </div>
    {{#if actorUuid}}{{#if editable}}<div class="twoc-actor-tools"><button class="twoc-actor-remove" type="button" data-action="chooseActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Trocar {{#if slotLabel}}{{slotLabel}}{{else}}responsável{{/if}} de {{name}}" title="Trocar"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i></button><button class="twoc-actor-remove" type="button" data-action="removeActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Remover {{#if slotLabel}}{{slotLabel}}{{else}}responsável{{/if}} de {{name}}" title="Remover"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>{{/if}}{{/if}}
  </div>
  {{/inline}}
  {{#*inline "questAssignee"}}
  <div class="twoc-quest-assignee {{#if actorUuid}}has-actor{{/if}} {{#if actorMissing}}is-missing{{/if}}" {{#if canAssign}}data-drop-definition="{{id}}" data-drop-kind="{{kind}}"{{/if}} data-actor-uuid="{{actorUuid}}" role="group" aria-label="Responsável por {{name}}" title="{{#if actorUuid}}{{actorName}}{{#if openQuestCount}} · {{openQuestCount}} Quests abertas{{/if}}{{else}}Arraste um personagem para esta Quest{{/if}}">
    {{#if actorUuid}}<button type="button" class="twoc-quest-portrait" data-action="openActor" data-id="{{id}}" data-kind="{{kind}}" data-actor-uuid="{{actorUuid}}" aria-label="Abrir ficha de {{actorName}}" {{#unless canOpenActor}}disabled{{/unless}}>{{#if actorImg}}<img src="{{actorImg}}" alt="{{actorName}}">{{else}}<i class="fa-solid fa-user" aria-hidden="true"></i>{{/if}}</button><span class="twoc-quest-assignee-name">{{actorName}}{{#if openQuestCount}}<small>{{openQuestCount}}</small>{{/if}}</span>{{#if canAssign}}<button class="twoc-icon-button twoc-quest-unassign" type="button" data-action="removeActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Remover responsável de {{name}}" title="Remover responsável"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>{{/if}}
    {{else}}{{#if canAssign}}<button type="button" class="twoc-quest-drop" data-action="chooseActor" data-id="{{id}}" data-kind="{{kind}}" aria-label="Escolher responsável para {{name}}"><i class="fa-solid fa-user-plus" aria-hidden="true"></i><span>Arraste aqui</span></button>{{else}}<span class="twoc-quest-unassigned"><i class="fa-solid fa-user" aria-hidden="true"></i></span>{{/if}}{{/if}}
  </div>{{/inline}}
  {{#*inline "taskCard"}}
  <details class="twoc-task-card {{#if questCompleted}}is-complete{{/if}}" data-definition-details="{{key}}" data-task-id="{{id}}" data-task-kind="{{kind}}">
    <summary><span class="twoc-task-chevron"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></span><span class="twoc-task-title"><strong>{{name}}</strong><span class="twoc-task-caption"><span>{{questStatus}}</span>{{#if questCompleted}}<span class="twoc-result-badge twoc-result-{{resultClass}}">{{resultLabel}}</span>{{/if}}{{#if repeatable}}<span>Repetível</span>{{/if}}<span>{{durationLabel}}</span>{{#if requiresCheck}}<span>{{skillLabel}}</span>{{/if}}{{#each costLabels}}<span class="twoc-reward-chip">−{{value}} {{label}}</span>{{/each}}{{#each rewardLabels}}<span class="twoc-reward-chip">+{{value}} {{label}}</span>{{/each}}{{#unless questCompleted}}{{#if effectCount}}<span>{{effectCountLabel}}</span>{{/if}}{{/unless}}</span></span><span class="twoc-task-summary-tools">{{> questAssignee this}}{{#if requiresCheck}}<span class="twoc-dc">CD {{dc}}</span>{{#unless questCompleted}}<button class="twoc-task-roll" type="button" data-action="rollActivity" data-kind="{{kind}}" data-id="{{id}}" {{#unless editable}}disabled{{/unless}} aria-label="Rolar {{name}}"><i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button>{{/unless}}{{/if}}{{#if isGM}}{{#unless archived}}<button class="twoc-icon-button" type="button" data-action="editDefinition" data-kind="{{kind}}" data-id="{{id}}" title="Editar" aria-label="Editar {{name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button class="twoc-icon-button" type="button" data-action="expansion" data-op="definitionDelete" data-kind="{{kind}}" data-id="{{id}}" title="Excluir" aria-label="Excluir {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}{{/if}}</span></summary>
    <div class="twoc-task-body">{{#if questCompleted}}<div class="twoc-completed-result"><strong class="twoc-result-heading twoc-result-{{resultClass}}">{{resultLabel}}</strong>{{#if resultNarrative}}<p class="twoc-prewrap">{{resultNarrative}}</p>{{else}}<p class="twoc-no-effects">Sem relato registrado.</p>{{/if}}</div>{{else}}{{#if description}}<p class="twoc-description twoc-prewrap">{{description}}</p>{{/if}}<div class="twoc-action-meta">{{#if requiresCheck}}<span>{{skillLabel}}</span><span>Adequação {{suitability}}</span>{{else}}<span>Conclusão pelo Mestre</span>{{/if}}</div>
      {{#if stages}}<details class="twoc-task-notes"><summary>Etapas</summary><p class="twoc-prewrap">{{stages}}</p></details>{{/if}}{{#if benefit}}<p class="twoc-benefit twoc-prewrap">{{benefit}}</p>{{/if}}
      {{#each outcomeEffects}}<div class="twoc-task-effect"><strong>{{signed}}</strong><span>{{name}}<small>{{targetLabel}}</small></span></div>{{/each}}{{/if}}
      <div class="twoc-task-footer">{{#if completionWeek}}<small>Conclusão: semana {{completionWeek}}{{#if benefitsApplied}} · benefícios aplicados{{/if}}{{#if pastRunsCount}} · {{pastRunsLabel}}{{/if}}</small>{{else}}{{#if pastRunsCount}}<small>{{pastRunsLabel}}</small>{{/if}}{{/if}}{{#if isGM}}{{#unless archived}}<div class="twoc-quest-tools">{{#if questCompleted}}<button type="button" data-action="expansion" data-op="questResult" data-kind="{{kind}}" data-id="{{id}}">Alterar resultado</button>{{/if}}{{#if isProject}}<button type="button" data-action="expansion" data-op="projectStatus" data-id="{{id}}">Alterar estado</button>{{#if questPending}}<button type="button" data-action="expansion" data-op="projectStart" data-id="{{id}}">Iniciar</button>{{/if}}{{#if canComplete}}<button type="button" data-action="expansion" data-op="projectComplete" data-id="{{id}}">{{#if questCompleted}}Contabilizar duração{{else}}Concluir obra{{/if}}</button>{{/if}}{{else}}{{#if questPending}}<button type="button" data-action="manage" data-op="questStart" data-id="{{id}}">Iniciar</button>{{/if}}{{#if canComplete}}<button type="button" data-action="manage" data-op="questComplete" data-id="{{id}}">{{#if questCompleted}}Contabilizar duração{{else}}Concluir{{/if}}</button>{{/if}}{{#if questCompleted}}{{#if repeatable}}<button type="button" data-action="expansion" data-op="questRepeat" data-id="{{id}}">Nova execução</button>{{/if}}{{/if}}{{/if}}</div>{{/unless}}{{/if}}</div>
    </div>
  </details>{{/inline}}
  <header class="twoc-banner">
    <div class="twoc-identity">{{#if isGM}}<button type="button" class="twoc-crest" data-action="manage" data-op="crest" aria-label="Escolher brasão do reino" title="Escolher brasão">{{> crest}}</button>{{else}}<span class="twoc-crest">{{> crest}}</span>{{/if}}<div><p class="twoc-eyebrow">The Weight of the Crown</p><h1>{{name}}</h1></div></div>
    {{#unless invalid}}<div class="twoc-banner-actions"><div class="twoc-demographic-controls"><button type="button" data-action="expansion" data-op="population" title="População total, incluindo soldados" {{#unless isGM}}disabled{{/unless}}><i class="fa-solid fa-users" aria-hidden="true"></i><span>População<strong>{{population}}</strong></span></button><button type="button" data-action="expansion" data-op="militaryTab" title="Efetivo das unidades cadastradas"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span>Exército<strong>{{armyLabel}}</strong></span></button></div><div class="twoc-calendar-controls">{{#if isGM}}<button class="twoc-week" type="button" data-action="manage" data-op="advanceWeeks" title="Avançar calendário">Semana <strong>{{week}}</strong><i class="fa-solid fa-plus" aria-hidden="true"></i></button>{{else}}<span class="twoc-week">Semana <strong>{{week}}</strong></span>{{/if}}<div class="twoc-season-control"><label class="twoc-visually-hidden" for="season-{{actorId}}">Estação atual</label><select id="season-{{actorId}}" data-command="season" aria-label="Estação atual" {{#unless isGM}}disabled{{/unless}}><option value="" disabled {{#unless hasSeason}}selected{{/unless}}>Estação</option>{{#each seasons}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{icon}} {{label}}</option>{{/each}}</select><button type="button" data-action="manage" data-op="effects" data-scope="season" title="Efeitos da estação" aria-label="Efeitos da estação"><i class="fa-solid fa-sliders" aria-hidden="true"></i></button></div></div><div class="twoc-level"><span>Nível</span><strong>{{level}}</strong></div>
      <details class="twoc-sheet-menu"><summary aria-label="Opções da ficha" title="Opções da ficha"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></summary>
        <div class="twoc-menu-items">{{#if isGM}}<button type="button" data-action="expansion" data-op="creation"><i class="fa-solid fa-landmark" aria-hidden="true"></i>Criação do reino</button>{{/if}}<button type="button" data-action="manage" data-op="effects" data-scope="realm"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>Efeitos do reino</button><button type="button" data-action="exportRealm"><i class="fa-solid fa-file-export" aria-hidden="true"></i>Exportar reino</button>{{#if isGM}}<button type="button" data-action="importRealm"><i class="fa-solid fa-file-import" aria-hidden="true"></i>Importar reino</button><button type="button" data-action="ownership"><i class="fa-solid fa-user-lock" aria-hidden="true"></i>Permissões</button>{{#if crestImage}}<button type="button" data-action="manage" data-op="removeCrest">Remover brasão</button>{{/if}}{{/if}}{{#if sectionPrivate}}<hr><button type="button" data-action="exportPrivate">Exportar notas</button><button type="button" data-action="importPrivate">Importar notas</button>{{/if}}</div>
      </details>
    </div>{{/unless}}
  </header>
  {{#if invalid}}<div class="twoc-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><h2>Não foi possível abrir o reino</h2><p>{{error}}</p></div>
  {{else}}
  <nav class="twoc-nav" aria-label="Seções da ficha">
    <button type="button" data-action="section" data-section="realm" class="{{#if sectionRealm}}active{{/if}}" aria-pressed="{{sectionRealm}}"><i class="fa-solid fa-landmark" aria-hidden="true"></i>Visão geral</button>
    <button type="button" data-action="section" data-section="definitions" class="{{#if sectionDefinitions}}active{{/if}}" aria-pressed="{{sectionDefinitions}}"><i class="fa-solid fa-scroll" aria-hidden="true"></i>Quests e obras</button>
    <button type="button" data-action="section" data-section="roles" class="{{#if sectionRoles}}active{{/if}}" aria-pressed="{{sectionRoles}}"><i class="fa-solid fa-users" aria-hidden="true"></i>Cargos</button>
    <button type="button" data-action="section" data-section="military" class="{{#if sectionMilitary}}active{{/if}}" aria-pressed="{{sectionMilitary}}"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Exército</button>
    <button type="button" data-action="section" data-section="progression" class="{{#if sectionProgression}}active{{/if}}" aria-pressed="{{sectionProgression}}"><i class="fa-solid fa-seedling" aria-hidden="true"></i>Progressão</button>
    <button type="button" data-action="section" data-section="history" class="{{#if sectionHistory}}active{{/if}}" aria-pressed="{{sectionHistory}}"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i>Histórico</button>
    {{#if isGM}}<button type="button" data-action="section" data-section="private" class="{{#if sectionPrivate}}active{{/if}}" aria-pressed="{{sectionPrivate}}"><i class="fa-solid fa-feather-pointed" aria-hidden="true"></i>Notas do Mestre</button>{{/if}}
  </nav>
  <div class="twoc-layout">
    <aside class="twoc-sidebar">
      <section class="twoc-side-section"><h2><i class="fa-solid fa-coins" aria-hidden="true"></i>Reservas{{#if canEdit}}<button class="twoc-side-tool" type="button" data-action="manage" data-op="resources" title="Conferir reservas" aria-label="Conferir todas as reservas"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{/if}}</h2><div class="twoc-resource-capacity" title="{{resourceCapacityTitle}}"><strong>{{resourceTotal}}</strong><span>/ {{resourceCapacity}}</span>{{#if isGM}}<button class="twoc-side-tool" type="button" data-action="manage" data-op="effects" title="Editar efeitos do limite de reservas" aria-label="Editar efeitos do limite de reservas"><i class="fa-solid fa-warehouse" aria-hidden="true"></i></button>{{/if}}</div><div class="twoc-stock-track" aria-hidden="true"><span style="width:{{resourcePercent}}%"></span></div>{{#if resourceExcess}}<p class="twoc-stock-warning" role="alert">Excesso de {{resourceExcess}} recursos</p>{{/if}}{{#if resourceUnknown}}<small class="twoc-stock-unknown">Há reservas a definir</small>{{/if}}{{#each resources}}<label class="twoc-resource"><span>{{label}}</span><input aria-label="{{label}}" type="number" step="1" min="0" data-field="{{path}}" value="{{value}}" placeholder="—" {{#unless ../canEdit}}disabled{{/unless}}></label>{{/each}}</section>
      <section class="twoc-side-section"><h2><i class="fa-solid fa-sun" aria-hidden="true"></i>Progressão</h2><label class="twoc-resource"><span>Experiência</span><input aria-label="XP do reino" type="number" step="1" min="0" data-field="progression.xp" value="{{xp}}" placeholder="—" {{#unless canEdit}}disabled{{/unless}}></label><span class="twoc-xp-target">/ 1.000 XP</span>{{#if isGM}}<label class="twoc-resource twoc-level-field"><span>Nível</span><input aria-label="Nível do reino" type="number" step="1" min="1" max="20" data-field="progression.level" value="{{level}}"></label>{{/if}}</section>
      <div class="twoc-sidebar-seal" aria-hidden="true"><span></span><i class="fa-solid fa-crown"></i><span></span></div>
    </aside>
    <main class="twoc-content">
      {{#if pendingTasks}}<aside class="twoc-pending-tasks" aria-label="Operações pendentes"><strong>Finalização pendente</strong>{{#each pendingTasks}}<div><span>{{label}}</span><button type="button" data-action="retryOperation" data-task-id="{{id}}">Tentar novamente</button></div>{{/each}}</aside>{{/if}}
      {{#if sectionRealm}}
      <section class="twoc-attributes" aria-label="Atributos do reino">{{#each attributes}}<article class="twoc-attribute"><h2>{{label}}</h2><strong>{{total}}</strong><label>Base<input aria-label="Base de {{label}}" type="number" step="1" min="0" data-field="{{path}}" value="{{base}}" placeholder="—" {{#unless ../canEdit}}disabled{{/unless}}></label>{{#if adjustment}}<small title="Filiação imperial">Império +{{adjustment}}</small>{{/if}}{{#if advancement}}<small>Progressão +{{advancement}}</small>{{/if}}{{#if hasOriginBonus}}<small title="{{originDescription}}">Origem {{originTotal}}</small>{{/if}}</article>{{/each}}</section>
      <details class="twoc-origin-panel" hidden><summary><strong>Origem do reino</strong><span>{{originLabels}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><div>{{#if originLabels}}{{#each originBonuses}}<span>{{label}} · {{abilityLabel}} <strong>{{signed}}</strong></span>{{/each}}<span>Talento extra: <strong>{{governmentFeatName}}</strong></span>{{/if}}{{#if isGM}}<button type="button" data-action="expansion" data-op="creation">{{#if originLabels}}Revisar criação{{else}}Configurar origem{{/if}}</button>{{/if}}</div></details>
      <section class="twoc-panel twoc-rolls"><div class="twoc-section-heading"><h2>Quests</h2><span class="twoc-section-rule" aria-hidden="true"></span></div><div class="twoc-activity-grid">{{#each actions}}{{> taskCard this editable=../canEdit isGM=../isGM}}{{else}}<div class="twoc-empty-state"><p>Nenhuma Quest disponível.</p>{{#if isGM}}<button type="button" data-action="createActivity">Criar Quest</button>{{/if}}</div>{{/each}}</div></section>
      <section class="twoc-panel"><div class="twoc-section-heading"><h2>Construções</h2><span class="twoc-section-rule" aria-hidden="true"></span></div><div class="twoc-activity-grid">{{#each projects}}{{> taskCard this editable=../canEdit isGM=../isGM}}{{else}}<div class="twoc-empty-state"><p>Nenhuma construção em aberto.</p>{{#if isGM}}<button type="button" data-action="createProject">Criar construção</button>{{/if}}</div>{{/each}}</div></section>
      <section class="twoc-panel twoc-competencies"><div class="twoc-section-heading"><h2>Competências</h2><span class="twoc-section-rule" aria-hidden="true"></span></div><div class="twoc-skills">{{#each skills}}<div class="twoc-skill"><div><button class="twoc-skill-roll" type="button" data-action="rollSkill" data-id="{{id}}" aria-label="Rolar {{label}}" {{#unless ../canEdit}}disabled{{/unless}}>{{label}} <i class="fa-solid fa-dice-d20" aria-hidden="true"></i></button><small>{{abilityLabel}}</small></div><div class="twoc-rank-control">{{#if hasAdvancement}}<span class="twoc-rank-badge" title="Grau atual com aumentos de progressão">{{rankLabel}}</span>{{else}}<select id="skill-{{../actorId}}-{{id}}" aria-label="Proficiência em {{label}}" data-field="{{path}}" {{#unless ../canEdit}}disabled{{/unless}}>{{#each ranks}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}{{#if ../canEdit}}<button type="button" data-action="manage" data-op="improveSkill" data-id="{{id}}" title="Melhorar {{label}} pela progressão" aria-label="Melhorar {{label}}"><i class="fa-solid fa-plus"></i></button>{{/if}}</div><strong title="{{modifierSummary}}">{{total}}</strong></div>{{/each}}</div></section>
      {{/if}}
      {{#if sectionDefinitions}}
      <section class="twoc-panel"><div class="twoc-heading"><div class="twoc-section-heading"><h2>Quests</h2><span class="twoc-section-rule" aria-hidden="true"></span></div>{{#if isGM}}<button class="twoc-create-button" type="button" data-action="createActivity"><i class="fa-solid fa-plus" aria-hidden="true"></i>Criar Quest</button>{{/if}}</div><div class="twoc-task-list">{{#each actions}}{{> taskCard this editable=../canEdit isGM=../isGM}}{{else}}<p class="twoc-no-effects">Nenhuma Quest criada.</p>{{/each}}</div></section>
      <section class="twoc-panel"><div class="twoc-heading"><div class="twoc-section-heading"><h2>Construções</h2><span class="twoc-section-rule" aria-hidden="true"></span></div>{{#if isGM}}<button class="twoc-create-button" type="button" data-action="createProject"><i class="fa-solid fa-plus" aria-hidden="true"></i>Criar construção</button>{{/if}}</div><div class="twoc-task-list">{{#each projects}}{{> taskCard this editable=../canEdit isGM=../isGM}}{{else}}<p class="twoc-no-effects">Nenhuma construção criada.</p>{{/each}}</div></section>
      <section class="twoc-panel"><div class="twoc-section-heading"><h2>Concluídas</h2><span class="twoc-section-rule" aria-hidden="true"></span></div><div class="twoc-task-list">{{#each completedDefinitions}}{{> taskCard this editable=../canEdit isGM=../isGM}}{{else}}<p class="twoc-no-effects">Nenhuma Quest ou construção concluída.</p>{{/each}}</div></section>
      {{/if}}
      {{#if sectionMilitary}}<section class="twoc-panel"><div class="twoc-heading"><div class="twoc-section-heading"><h2>Exército</h2><span class="twoc-section-rule"></span><span>{{armyUnitCountLabel}} · {{armyLabel}} soldados</span></div>{{#if isGM}}<div class="twoc-army-header-tools"><button type="button" data-action="expansion" data-op="unitTrain">Treinar tropa</button><button type="button" data-action="expansion" data-op="unitAdd">Criar tropa</button></div>{{/if}}</div>
      {{#if isGM}}<div class="twoc-army-drop" data-drop-army="true">Arraste uma ficha militar existente para vinculá-la ao reino</div>{{/if}}
      <div class="twoc-task-list">{{#each militaryUnits}}<details class="twoc-unit-card" data-definition-details="{{key}}" data-unit-id="{{id}}"><summary><i class="fa-solid fa-chevron-right"></i><strong>{{name}}</strong><span class="twoc-unit-badge">{{armyTypeLabel}} · Nv. {{level}}</span><span class="twoc-unit-stat-chip">CA {{ac}} · PV {{hpCurrent}}/{{hpMax}}</span><span>{{headcountLabel}} soldados</span>{{#if ../isGM}}<span class="twoc-task-summary-tools"><button type="button" class="twoc-icon-button" data-action="expansion" data-op="unitEdit" data-id="{{id}}" aria-label="Administrar {{name}}"><i class="fa-solid fa-pen"></i></button><button type="button" class="twoc-icon-button" data-action="expansion" data-op="unitDelete" data-id="{{id}}" aria-label="Excluir {{name}}"><i class="fa-solid fa-trash"></i></button></span>{{/if}}</summary><div class="twoc-task-body">
      {{#if armyMissing}}<p class="twoc-form-error">Ficha militar não vinculada ou indisponível. Os dados anteriores estão preservados.</p>{{#if ../isGM}}<button type="button" data-action="expansion" data-op="unitLink" data-id="{{id}}">Vincular / recuperar ficha</button>{{/if}}{{else}}<button type="button" data-action="expansion" data-op="unitSheet" data-id="{{id}}"><i class="fa-solid fa-shield-halved"></i> Abrir ficha militar</button>{{/if}}
      {{> actorSlot this kind="military" slotLabel="Capitão (grupo de 10 a 15 soldados)" editable=../isGM}}
      <div class="twoc-army-stats"><label class="twoc-army-stat-input"><small>Soldados</small><input aria-label="Soldados de {{name}}" type="number" min="0" max="100000" step="1" data-field="{{headcountPath}}" value="{{headcountInput}}" {{#unless ../canEdit}}disabled{{/unless}}></label><label class="twoc-army-stat-input"><small>Consumo de Comida</small><input aria-label="Consumo de Comida de {{name}}" type="number" min="0" max="100" step="1" data-field="{{consumptionPath}}" value="{{consumption}}" {{#unless ../canEdit}}disabled{{/unless}} {{#if armyMissing}}disabled{{/if}}></label>
      <span><small>CA</small><strong>{{ac}}</strong></span><span><small>PV</small><strong>{{hpCurrent}} / {{hpMax}}</strong></span><span><small>Debandada</small><strong>{{routThreshold}}</strong></span><span><small>Manobra</small><strong>{{maneuverSigned}}</strong></span><span><small>Moral</small><strong>{{moraleSigned}}</strong></span><span><small>Explorador</small><strong>{{scoutingSigned}}</strong></span><span><small>Bônus de Ataque Melee</small><strong>{{meleeSigned}}</strong></span><span><small>Distância</small><strong>{{rangedSigned}}</strong></span></div>
      <dl class="twoc-unit-details">{{#if tactics}}<dt>Táticas</dt><dd>{{tactics}}</dd>{{/if}}{{#if task}}<dt>Tarefa</dt><dd>{{task}}</dd>{{/if}}{{#if location}}<dt>Local</dt><dd>{{location}}</dd>{{/if}}{{#if condition}}<dt>Condição</dt><dd>{{condition}}</dd>{{/if}}{{#if notes}}<dt>Observações</dt><dd>{{notes}}</dd>{{/if}}</dl>
      {{#if ../isGM}}{{#unless armyMissing}}<div class="twoc-task-footer"><button type="button" data-action="expansion" data-op="unitTrain" data-id="{{id}}">Treinar tropa · 1 semana</button></div>{{/unless}}{{/if}}</div></details>{{else}}<div class="twoc-empty-state"><p>Nenhuma tropa cadastrada.</p></div>{{/each}}</div></section>{{/if}}
      {{#if sectionRoles}}
      <section class="twoc-panel twoc-roles-panel">
        <div class="twoc-heading"><div class="twoc-section-heading"><h2>Conselho do reino</h2><span class="twoc-section-rule" aria-hidden="true"></span><span class="twoc-role-count">{{occupiedRoles}} / {{roleCount}}</span></div>{{#if isGM}}<button class="twoc-create-button" type="button" data-action="createRole"><i class="fa-solid fa-plus" aria-hidden="true"></i>Criar cargo</button>{{/if}}</div>
        <div class="twoc-role-grid">{{#each roles}}
          <article class="twoc-role-card {{#if vacant}}is-vacant{{/if}}" data-role-id="{{id}}">
            <div class="twoc-action-heading"><div class="twoc-role-title"><h3>{{name}}</h3><span class="twoc-role-kind">{{#if standard}}Padrão{{else}}Personalizado{{/if}}</span></div><div class="twoc-definition-tools">{{#if ../isGM}}<button class="twoc-icon-button" type="button" data-action="addRoleEffect" data-id="{{id}}" aria-label="Adicionar efeito a {{name}}" title="Adicionar efeito"><i class="fa-solid fa-plus" aria-hidden="true"></i></button><button class="twoc-icon-button" type="button" data-action="editRole" data-id="{{id}}" aria-label="Editar {{name}}" title="Editar cargo"><i class="fa-solid fa-pen" aria-hidden="true"></i></button>{{#unless standard}}<button class="twoc-icon-button" type="button" data-action="deleteRole" data-id="{{id}}" aria-label="Excluir {{name}}" title="Excluir cargo"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/unless}}{{/if}}</div></div>
            {{> actorSlot this kind="role" editable=../canEdit}}
            <div class="twoc-vacancy {{#if vacant}}is-active{{/if}}" title="Bônus/penalidade por vacância{{#if occupied}} · inativa enquanto ocupado{{/if}}"><span class="twoc-role-status">{{#if occupied}}Ocupado{{else}}Vago{{/if}}</span><strong>{{vacancyLabel}}{{#if occupied}} · inativa{{/if}}</strong></div>
            {{#if hasDetails}}<details class="twoc-role-details" data-role-details="{{id}}"><summary>{{#if effectCount}}{{effectsLabel}}{{else}}Descrição{{/if}}<i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
            {{#if description}}<p class="twoc-description twoc-prewrap">{{description}}</p>{{/if}}
            <div class="twoc-role-effects">
              {{#each effects}}<div class="twoc-role-effect {{#if ../vacant}}is-inactive{{/if}}"><span class="twoc-effect-value">{{signed}}</span><div><strong>{{name}}</strong><small>{{targetLabel}} · {{conditionLabel}}</small>{{#if description}}<p class="twoc-prewrap">{{description}}</p>{{/if}}</div>{{#if ../../isGM}}<div class="twoc-definition-tools"><button class="twoc-icon-button" type="button" data-action="editRoleEffect" data-id="{{../id}}" data-effect-id="{{id}}" aria-label="Editar efeito {{name}}" title="Editar efeito"><i class="fa-solid fa-pen" aria-hidden="true"></i></button><button class="twoc-icon-button" type="button" data-action="deleteRoleEffect" data-id="{{../id}}" data-effect-id="{{id}}" aria-label="Remover efeito {{name}}" title="Remover efeito"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>{{/if}}</div>{{/each}}
            </div></details>{{/if}}
          </article>
        {{/each}}</div>
      </section>
      {{/if}}
      {{#if sectionProgression}}
      <section class="twoc-panel"><div class="twoc-heading"><div class="twoc-section-heading"><h2>Progressão do reino</h2><span class="twoc-section-rule" aria-hidden="true"></span><span class="twoc-role-count">{{pendingFeaturesLabel}}</span></div><button type="button" class="twoc-create-button" data-action="manage" data-op="feats"><i class="fa-solid fa-book-open" aria-hidden="true"></i>Talentos</button></div>
      <div class="twoc-active-feats"><button type="button" data-action="manage" data-op="featTools"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i>Usar talentos</button>{{#each activeFeats}}<span>{{name}}{{#if skillLabel}} · {{skillLabel}}{{/if}}</span>{{/each}}</div>
      <table class="twoc-progression-table"><thead><tr><th>Nível</th><th>Escolhas</th></tr></thead><tbody>{{#each progressionRows}}<tr class="{{#if current}}is-current{{/if}}"><th scope="row">{{level}}</th><td>{{#each features}}<button type="button" class="twoc-feature {{#if selected}}is-selected{{/if}} {{#if locked}}is-locked{{/if}}" data-action="manage" data-op="chooseFeature" data-id="{{id}}" title="{{#if selected}}Clique para desfazer esta escolha{{/if}}" {{#if locked}}disabled{{/if}} {{#unless ../../canEdit}}disabled{{/unless}}><span>{{#if selected}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{else}}{{#if locked}}<i class="fa-solid fa-lock" aria-hidden="true"></i>{{else}}<i class="fa-solid fa-plus" aria-hidden="true"></i>{{/if}}{{/if}}{{label}}{{#if summary}} · <strong>{{summary}}</strong>{{/if}}</span><small>{{status}}</small></button>{{else}}<span class="twoc-no-feature">—</span>{{/each}}</td></tr>{{/each}}</tbody></table></section>
      {{/if}}
      {{#if sectionHistory}}<section class="twoc-panel"><div class="twoc-section-heading"><h2>Histórico</h2><span class="twoc-section-rule" aria-hidden="true"></span></div>{{#each operations}}<article class="twoc-history"><span class="twoc-history-marker" aria-hidden="true"></span><div><strong>{{label}}</strong><p>{{summary}}</p><small>{{at}} · {{userId}}</small></div></article>{{else}}<div class="twoc-empty-state"><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><p>Ainda não há registros.</p></div>{{/each}}</section>{{/if}}
      {{#if sectionPrivate}}<section class="twoc-panel twoc-notes"><div class="twoc-section-heading"><h2>Notas do Mestre</h2><span class="twoc-section-rule" aria-hidden="true"></span><i class="fa-solid fa-lock" aria-hidden="true"></i></div><label class="twoc-visually-hidden" for="notes-{{actorId}}">Notas do Mestre</label><textarea id="notes-{{actorId}}" aria-label="Notas do Mestre" rows="18" data-field="gmNotes" placeholder="Escreva suas notas…">{{gmNotes}}</textarea></section>{{/if}}

    </main>
  </div>
  <footer class="twoc-footer"><span role="status" aria-live="polite">{{status}}</span></footer>
  {{/if}}
</section>
