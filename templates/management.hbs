<section class="twoc-management-shell"><header><h1>{{heading}}</h1>{{#if isGM}}<button type="button" data-action="add"><i class="fa-solid fa-plus" aria-hidden="true"></i>{{addLabel}}</button>{{/if}}</header><div class="twoc-management-list">
{{#each records}}<details class="twoc-library-entry" data-record-id="{{id}}"><summary class="twoc-action-heading"><h3>{{name}}</h3><span class="twoc-dc">{{badge}}</span></summary>{{#if description}}<p class="twoc-prewrap">{{description}}</p>{{/if}}{{#if requirements}}<small>{{requirements}}</small>{{/if}}<div class="twoc-library-tools">{{#if ../featMode}}<button type="button" data-action="effects" data-id="{{id}}">Efeitos ({{effectCount}})</button>{{/if}}{{#if ../isGM}}{{#unless ../featMode}}<button type="button" data-action="toggle" data-id="{{id}}" aria-label="{{#if enabled}}Desativar{{else}}Ativar{{/if}} {{name}}"><i class="fa-solid {{#if enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}" aria-hidden="true"></i>{{#if enabled}}Ativo{{else}}Inativo{{/if}}</button>{{/unless}}<button type="button" data-action="edit" data-id="{{id}}" aria-label="Editar {{name}}"><i class="fa-solid fa-pen" aria-hidden="true"></i>Editar</button>{{#unless retired}}<button type="button" data-action="remove" data-id="{{id}}" aria-label="Excluir {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i>{{#if ../featMode}}Excluir{{else}}Remover{{/if}}</button>{{/unless}}{{/if}}</div></details>{{else}}<div class="twoc-empty-state"><p>{{#if featMode}}Nenhum talento cadastrado.{{else}}Nenhum efeito cadastrado.{{/if}}</p></div>{{/each}}
</div></section>
