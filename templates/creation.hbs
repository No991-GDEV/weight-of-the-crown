<section class="twoc-editor-shell"><header class="twoc-wizard-header"><h1>Criação do reino</h1><ol>{{#each steps}}<li class="{{#if active}}active{{/if}} {{#if complete}}complete{{/if}}">{{#if complete}}<i class="fa-solid fa-check" aria-hidden="true"></i>{{/if}}{{label}}</li>{{/each}}</ol></header><form class="twoc-editor-body" autocomplete="off">
{{#if formError}}<p class="twoc-form-error" role="alert">{{formError}}</p>{{/if}}
{{#if stepOrigin}}<label>Nome do reino<input data-draft="name" maxlength="120" value="{{name}}" required></label><div class="twoc-form-pair"><label>Carta (Charter)<select data-draft="charterId"><option value="">Escolha a Carta</option>{{#each charters}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{summary}})</option>{{/each}}</select></label><label>Heartland<select data-draft="heartlandId"><option value="">Escolha o território inicial</option>{{#each heartlands}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{summary}})</option>{{/each}}</select></label></div><label>Governo<select data-draft="governmentId"><option value="">Escolha o Governo</option>{{#each governments}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}} ({{summary}})</option>{{/each}}</select></label><div class="twoc-form-pair"><label>Aumento livre da Carta<select data-draft="charterFree"><option value="">Escolha um atributo</option>{{#each charterFreeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Aumento livre do Governo<select data-draft="governmentFree"><option value="">Escolha um atributo</option>{{#each governmentFreeOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>{{#if govFeatName}}<article class="twoc-creation-benefit"><h3>Talento extra: {{govFeatName}}</h3><p>{{govFeatDescription}}</p></article>{{/if}}{{/if}}
{{#if stepAbilities}}<div class="twoc-editor-section-heading"><h2>Atributos iniciais</h2><strong data-points-counter>{{points}} / 4 pontos</strong></div><p>Distribua os quatro pontos livres. Os benefícios de origem e o +1 imperial entram à parte.</p><div class="twoc-wizard-abilities">{{#each attributes}}<label><span>{{label}}</span><input type="number" min="0" max="4" step="1" data-draft="allocations.{{id}}" value="{{value}}"><strong>Total {{total}}</strong><small>{{details}}</small></label>{{/each}}</div>{{/if}}
{{#if stepSkills}}<div class="twoc-editor-section-heading"><h2>Perícias treinadas</h2><strong>{{skillCount}} / 6</strong></div><div class="twoc-wizard-skills">{{#each skills}}<label><input type="checkbox" name="trained" value="{{id}}" {{#if selected}}checked{{/if}} {{#if required}}disabled{{/if}}><span>{{label}}<small>{{#if required}}Governo{{else}}{{abilityLabel}}{{/if}}</small></span></label>{{/each}}</div>{{/if}}
{{#if stepReview}}<h2>Revisar o reino</h2><p>{{originLabels}}</p><div class="twoc-creation-summary">{{#each attributes}}<span>{{label}} <strong>{{total}}</strong></span>{{/each}}</div><article class="twoc-creation-benefit"><h3>Perícias treinadas</h3><p>{{trainedLabels}}</p><h3>Talento extra do Governo</h3><p>{{govFeatName}}</p></article><label>População total, incluindo soldados<input data-draft="population" type="number" min="0" step="1" value="{{population}}" placeholder="A definir"></label><p class="twoc-review-note">Salvar aplica esta composição aos valores iniciais. Escolhas de progressão já feitas serão preservadas e verificadas.</p>{{/if}}
</form><footer class="twoc-editor-footer">{{#unless isFirst}}<button type="button" data-action="back">Voltar</button>{{/unless}}{{#if isLast}}<button class="twoc-primary" type="button" data-action="finish" {{#if busy}}disabled{{/if}}>{{#if isRevising}}Salvar revisão{{else}}Criar ficha do reino{{/if}}</button>{{else}}<button class="twoc-primary" type="button" data-action="next">Continuar <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{/if}}</footer></section>
