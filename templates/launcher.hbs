<section class="twoc-launcher-content"><div class="twoc-launcher-mark" aria-hidden="true"><i class="fa-solid fa-crown"></i></div><p class="twoc-eyebrow">The Weight of the Crown</p><h1>Seus reinos</h1><ul>{{#each realms}}<li><button class="twoc-realm-open" type="button" data-action="open" data-id="{{id}}"><span>{{name}}</span><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{{#if ../isGM}}<button class="twoc-realm-delete" type="button" data-action="delete" data-id="{{id}}" title="Excluir reino" aria-label="Excluir {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}</li>{{else}}<li class="twoc-launcher-empty">Nenhum reino disponível.</li>{{/each}}</ul>{{#if isGM}}<button class="twoc-launcher-create" type="button" data-action="create"><i class="fa-solid fa-plus" aria-hidden="true"></i>Criar reino</button>{{/if}}</section>
