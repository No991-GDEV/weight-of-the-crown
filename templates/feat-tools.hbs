<section class="twoc-management-shell"><header><h1>Talentos em uso</h1><span>Semana {{week}}</span></header><div class="twoc-management-list">
{{#each records}}<details class="twoc-feat-use-card" data-feat-key="{{key}}"><summary><strong>{{name}}{{#if skillLabel}} · {{skillLabel}}{{/if}}</strong><span>{{status}}</span></summary><div><p class="twoc-prewrap">{{description}}</p>{{#if note}}<small>{{note}}</small>{{/if}}{{#if actionLabel}}<button type="button" data-action="use" data-key="{{key}}" data-skill-id="{{skillId}}" {{#unless canUse}}disabled{{/unless}}>{{actionLabel}}</button>{{/if}}</div></details>{{else}}<p>Nenhum talento escolhido. Escolha talentos na Progressão ou defina o Governo na criação.</p>{{/each}}
{{#each reservations}}<p>Resistir à anarquia · teste em preparação <button type="button" data-action="cancel" data-token="{{token}}">Liberar preparação cancelada</button></p>{{/each}}
{{#if income}}<section class="twoc-feat-income"><h2>Fama e fortuna · a receber</h2>{{#each income}}<p>+{{amount}} Tesouro · {{label}}</p>{{/each}}{{#if canEdit}}<button type="button" data-action="collect">Receber valores disponíveis</button>{{/if}}</section>{{/if}}</div></section>
