<section class="twoc-editor-shell"><header class="twoc-editor-heading"><h1>{{#if isProject}}Construção{{else}}Quest{{/if}}</h1></header><form class="twoc-editor-body twoc-definition-form" autocomplete="off">
{{#if formError}}<p class="twoc-form-error" role="alert">{{formError}}</p>{{/if}}<label>Nome<input data-field-name="name" maxlength="120" value="{{name}}" required></label><label>Descrição<textarea data-field-name="description" rows="2" maxlength="12000">{{description}}</textarea></label><div class="twoc-form-pair"><label>Duração em semanas<input name="duration" type="number" min="1" max="10000" step="1" value="{{duration}}"></label><label class="twoc-checkbox"><input type="checkbox" data-field-name="requiresCheck" {{#if requiresCheck}}checked{{/if}}>Usa teste do reino</label></div>
{{#if requiresCheck}}<div class="twoc-check-definition"><label>Perícia<select data-field-name="skillId"><option value="">Escolha a perícia</option>{{#each skills}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><div class="twoc-form-pair"><label>CD<input data-field-name="dc" type="number" min="1" step="1" value="{{dc}}"></label><label>Adequação do responsável<input data-field-name="suitability" type="number" min="-2" max="2" step="1" value="{{suitability}}"></label></div></div>{{/if}}
{{#if isProject}}<label>Etapas<textarea data-field-name="stages" rows="2" maxlength="12000">{{stages}}</textarea></label>{{/if}}{{#unless isProject}}<label class="twoc-checkbox"><input type="checkbox" name="repeatable" {{#if repeatable}}checked{{/if}}>Quest repetível</label>{{/unless}}<label>Resultado geral / sem grau<textarea data-field-name="benefit" rows="2" maxlength="12000">{{benefit}}</textarea></label>
<fieldset class="twoc-degree-editor"><legend>Resultados por grau</legend><p>Nas concluídas aparece apenas o texto do grau escolhido. Campo vazio usa o resultado geral.</p><label>Sucesso crítico<textarea data-field-name="criticalSuccessText" rows="2" maxlength="12000">{{criticalSuccessText}}</textarea></label><label>Sucesso<textarea data-field-name="successText" rows="2" maxlength="12000">{{successText}}</textarea></label><label>Falha<textarea data-field-name="failureText" rows="2" maxlength="12000">{{failureText}}</textarea></label><label>Falha crítica<textarea data-field-name="criticalFailureText" rows="2" maxlength="12000">{{criticalFailureText}}</textarea></label></fieldset>
<details class="twoc-feat-tag-editor"><summary>Condições dos talentos</summary><div>{{#each featTags}}<label class="twoc-checkbox"><input type="checkbox" name="featTag" value="{{id}}" {{#if checked}}checked{{/if}}>{{label}}</label>{{/each}}</div></details>
<fieldset class="twoc-outcome-resources"><legend>Recursos ao concluir</legend><p>Positivo acrescenta; negativo deduz das reservas.</p><div>{{#each resources}}<label>{{label}}<input type="number" name="{{id}}" min="-100000" max="100000" step="1" value="{{amount}}"></label>{{/each}}</div></fieldset>
<section class="twoc-editor-effects"><div class="twoc-editor-section-heading"><h2>Efeitos ao concluir</h2><button type="button" data-action="addEffect"><i class="fa-solid fa-plus" aria-hidden="true"></i>Adicionar efeito</button></div>{{#each effects}}<article class="twoc-editor-effect"><div class="twoc-editor-effect-name"><label>Nome do efeito<input name="{{id}}_name" maxlength="120" value="{{name}}"></label><button type="button" data-action="removeEffect" data-id="{{id}}" aria-label="Remover efeito {{name}}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div><div class="twoc-form-pair"><label>Modificador<input type="number" name="{{id}}_value" min="-100" max="100" step="1" value="{{value}}"></label><label>Tipo<select name="{{id}}_type">{{#each types}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div><label>O que afeta<select name="{{id}}_target">{{{targetOptions}}}</select></label></article>{{else}}<p class="twoc-no-effects">Nenhum efeito configurado.</p>{{/each}}</section>
</form><footer class="twoc-editor-footer"><button class="twoc-primary" type="button" data-action="save" {{#if busy}}disabled{{/if}}><i class="fa-solid fa-check" aria-hidden="true"></i>Salvar {{#if isProject}}construção{{else}}Quest{{/if}}</button></footer></section>
